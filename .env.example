# --- storage -------------------------------------------------------------
# Global preferences live here; each project stores its graph in its own
# <project>/.turn/state.json file.
TURN_DATA_DIR=./turn

# Each project is created as its own assigned directory under this directory
# (e.g. ./projects/<id>/). Version control is managed outside Turn.
# TURN_PROJECTS_DIR=./projects

# --- execution ------------------------------------------------------------
# direct | prefect  (Prefect is an optional dependency)
TURN_EXECUTION_BACKEND=direct
TURN_MAX_RETRIES=1
TURN_RUNNER_TICK=0.5
TURN_RUN_TIMEOUT=600
TURN_STALL_TIMEOUT_SECONDS=90
TURN_JOB_DELAY_MS=0
TURN_RETRY_BACKOFF_MS=750
TURN_RETRY_CHOKED=1

# --- workers --------------------------------------------------------------
# The served app uses the selected real harness for planning.
TURN_PLANNER=codex
# default executor assigned to planned leaves
TURN_DEFAULT_EXECUTOR=codex
TURN_CODEX_BIN=codex
# extra flags passed to `codex exec`, e.g.:
# TURN_CODEX_ARGS="--dangerously-bypass-approvals-and-sandbox"
# TURN_CODEX_MODEL=gpt-5.6-luna
TURN_REASONING=medium
TURN_PERMISSION=workspace

# --- model (optional LLM planner; Codex is used by default) ---------------
# OPENAI_API_KEY=
# TURN_PLANNER_MODEL=gpt-4o-mini

# --- project resources ----------------------------------------------------
# Each project gets its own assigned directory under TURN_PROJECTS_DIR;
# there is no repository or worktree lifecycle for Turn to manage.
# TURN_SKILLS_DIR=/path/to/project/skills # local skills inherited by descendants
