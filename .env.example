# --- storage -------------------------------------------------------------
# Local SQLite store (zero external services).
TURN_DATABASE_URL="sqlite+aiosqlite:///./turnloop.db"

# Each project is created as its own git repository under this directory
# (e.g. ./projects/<id>/) so the user is left with a real, initialized repo of
# their finished work. Optional; leave unset for ./projects.
# TURN_PROJECTS_DIR=./projects

# --- execution ------------------------------------------------------------
# direct | prefect  (Prefect is an optional dependency)
TURN_EXECUTION_BACKEND=direct
TURN_MAX_CONCURRENCY=4
TURN_MAX_RETRIES=1
TURN_RUNNER_TICK=0.5
TURN_RUN_TIMEOUT=600
TURN_STALL_TIMEOUT_SECONDS=90
TURN_JOB_DELAY_MS=0
TURN_FORCE_SEQUENTIAL=0
TURN_RETRY_BACKOFF_MS=750
TURN_RETRY_CHOKED=1

# --- workers --------------------------------------------------------------
# codex | heuristic   (planner selection; heuristic works fully offline)
TURN_PLANNER=heuristic
# default executor assigned to planned leaves
TURN_DEFAULT_EXECUTOR=echo
TURN_CODEX_BIN=codex
# extra flags passed to `codex exec`, e.g.:
# TURN_CODEX_ARGS="--dangerously-bypass-approvals-and-sandbox"
# TURN_CODEX_MODEL=gpt-5.6-luna
TURN_REASONING=default
TURN_PERMISSION=workspace

# --- model (optional LLM planner; Codex is used by default) ---------------
# OPENAI_API_KEY=
# TURN_PLANNER_MODEL=gpt-4o-mini

# --- repo / resources -----------------------------------------------------
# Each project gets its OWN git repository (created under TURN_PROJECTS_DIR);
# there is no shared/global repository to configure.
# TURN_SKILLS_DIR=/path/to/project/skills # local skills inherited by descendants

# --- merge review ---------------------------------------------------------
# When a node's worktree has been merged up into its parent it is redundant on
# disk. Default OFF: the UI asks you to Accept (clean the subtree) / Reject
# (feedback into the same node) per merged node. Set to 1 to auto-accept and
# reclaim space without manual review.
# TURN_AUTO_ACCEPT_MERGES=0
