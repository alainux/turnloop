# --- storage -------------------------------------------------------------
# Postgres is the authoritative store; SQLite is the local default.
# TURN_DATABASE_URL="postgresql+asyncpg://turn:turn@localhost:5432/turn"
TURN_DATABASE_URL="sqlite+aiosqlite:///./turnloop.db"

# --- execution ------------------------------------------------------------
# direct | prefect  (Prefect is an optional dependency)
TURN_EXECUTION_BACKEND=direct
TURN_MAX_CONCURRENCY=4
TURN_MAX_RETRIES=1
TURN_RUNNER_TICK=0.5
TURN_RUN_TIMEOUT=600

# --- workers --------------------------------------------------------------
# codex | heuristic   (planner selection; heuristic works fully offline)
TURN_PLANNER=heuristic
# default executor assigned to planned leaves
TURN_DEFAULT_EXECUTOR=echo
TURN_CODEX_BIN=codex
# extra flags passed to `codex exec`, e.g.:
# TURN_CODEX_ARGS="--model gpt-5-codex"

# --- model (optional LLM planner; Codex is used by default) ---------------
# OPENAI_API_KEY=
# TURN_PLANNER_MODEL=gpt-4o-mini

# --- repo / resources -----------------------------------------------------
# TURN_REPO_PATH=/path/to/software/repo   # codex worker isolates a worktree here
# TURN_SKILLS_DIR=/path/to/project/skills # local skills inherited by descendants
